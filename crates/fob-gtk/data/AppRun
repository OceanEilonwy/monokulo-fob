#!/bin/sh
# Starts Fob from inside its AppImage. Finds what's bundled, and leaves the rest
# (display, theme, fonts, graphics drivers) to the desktop it's on.
here=$(dirname "$(readlink -f "$0")")
export XDG_DATA_DIRS="$here/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$here/usr/share/glib-2.0/schemas"
export GDK_PIXBUF_MODULE_FILE="$here/usr/lib/gdk-pixbuf-loaders.cache"
# The desktop's GIO modules were built for its own GLib, not the bundled one.
export GIO_MODULE_DIR="$here/usr/lib/gio/modules"
exec "$here/usr/bin/fob" "$@"
