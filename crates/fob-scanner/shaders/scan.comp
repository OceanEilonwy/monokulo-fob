    return Comp(fsub(pp, mm), fadd(pp, mm), fadd(zz2, tt), fsub(zz2, tt));
}
Niels niels(Ext e) { return Niels(fadd(e.y, e.x), fsub(e.y, e.x), e.z, fmul(e.t, D2)); }

// One key's state: Q (4 Fe), then a table of 1R..8R (8 Niels), then a flag.
const uint STRIDE = 300u;
const uint TABLE = 32u;
const uint FLAG = 288u;

Fe fselect(Fe a, Fe b, uint m) {
    return Fe((a.a0 & ~m) | (b.a0 & m), (a.a1 & ~m) | (b.a1 & m), (a.a2 & ~m) | (b.a2 & m), (a.a3 & ~m) | (b.a3 & m), (a.a4 & ~m) | (b.a4 & m), (a.a5 & ~m) | (b.a5 & m), (a.a6 & ~m) | (b.a6 & m), (a.a7 & ~m) | (b.a7 & m));
}

// A key's table, held in the shader's registers while it works through a dispatch.
Fe typ[8], tym[8], tz[8], tt2d[8];

void load_table(uint base) {
    for (uint i = 0u; i < 8u; i++) {
        uint at = base + TABLE + i * 32u;
        typ[i] = sload(at);
        tym[i] = sload(at + 8u);
        tz[i] = sload(at + 16u);
        tt2d[i] = sload(at + 24u);
    }
}

// The entry for a digit, reading them all: all ones in m when i is the digit's size.
Niels table_entry(int digit) {
    uint negative = uint(digit) >> 31;
    uint size = (uint(digit) ^ (0u - negative)) + negative;
    Fe yp = ONE, ym = ONE, z = ONE, t2d = ZERO;
    for (uint i = 0u; i < 8u; i++) {
        uint differs = size ^ (i + 1u);
        uint m = ((differs | (0u - differs)) >> 31) - 1u;
        yp = fselect(yp, typ[i], m);
        ym = fselect(ym, tym[i], m);
        z = fselect(z, tz[i], m);
        t2d = fselect(t2d, tt2d[i], m);
    }
    uint n = 0u - negative;
    return Niels(fselect(yp, ym, n), fselect(ym, yp, n), z, fselect(t2d, fneg(t2d), n));
}

void init_stage(uint key, uint base) {
    uint in_at = key * 8u;
    Fe y = Fe(input_keys.r[in_at + 0u], input_keys.r[in_at + 1u], input_keys.r[in_at + 2u], input_keys.r[in_at + 3u], input_keys.r[in_at + 4u], input_keys.r[in_at + 5u], input_keys.r[in_at + 6u], input_keys.r[in_at + 7u]);
    // The CPU sends only canonical keys, with no negative zero.
    uint sign = y.a7 >> 31;
    y.a7 &= 0x7fffffffu;
    Fe yy = fsq(y);
    Fe u = fsub(yy, ONE);
    Fe v = fadd(fmul(yy, D), ONE);
    Fe v3 = fmul(fsq(v), v);
    Fe v7 = fmul(fsq(v3), v);
    Fe eleven;
    Fe root = fmul(fsqn(fpow250(fmul(u, v7), eleven), 2), fmul(u, v7));
    Fe x = fmul(fmul(u, v3), root);
    Fe check = fmul(v, fsq(x));
    uint bad = 0u;
    if (feq(check, fneg(u))) x = fmul(x, SQRT_M1);
    else if (!feq(check, u)) bad = 1u;
    if ((freeze(x).a0 & 1u) != sign) x = fneg(x);
    state.s[base + FLAG] = bad;
    Ext p = Ext(x, y, ONE, fmul(x, y));
    Niels n = niels(p);
    Niels first = n;
    Ext q = p;
    for (uint i = 0u; i < 8u; i++) {
        uint at = base + TABLE + i * 32u;
        sstore(at, n.yp); sstore(at + 8u, n.ym); sstore(at + 16u, n.z); sstore(at + 24u, n.t2d);
        if (i < 7u) { q = comp_ext(eadd(q, first)); n = niels(q); }
    }
    // Q starts as the top digit's multiple.
    load_table(base);
    Ext e = comp_ext(eadd(Ext(ZERO, ONE, ONE, ZERO), table_entry(pc.d[0])));
    sstore(base, e.x); sstore(base + 8u, e.y); sstore(base + 16u, e.z); sstore(base + 24u, e.t);
}

void window_stage(uint base) {
    Ext q = Ext(sload(base), sload(base + 8u), sload(base + 16u), sload(base + 24u));
    load_table(base);
    for (int w = 0; w < STEPS; w++) {
        Proj s = Proj(q.x, q.y, q.z);
        for (int i = 0; i < 3; i++) s = comp_proj(pdouble(s));
        q = comp_ext(pdouble(s));
        q = comp_ext(eadd(q, table_entry(pc.d[w])));
    }
    sstore(base, q.x); sstore(base + 8u, q.y); sstore(base + 16u, q.z); sstore(base + 24u, q.t);
}

void final_stage(uint key, uint base) {
    Proj s = Proj(sload(base), sload(base + 8u), sload(base + 16u));
    for (int i = 0; i < 3; i++) s = comp_proj(pdouble(s));
    uint at = key * 25u;
    output_keys.o[at + 0u] = s.x.a0;
    output_keys.o[at + 8u] = s.y.a0;
    output_keys.o[at + 16u] = s.z.a0;
    output_keys.o[at + 1u] = s.x.a1;
    output_keys.o[at + 9u] = s.y.a1;
    output_keys.o[at + 17u] = s.z.a1;
    output_keys.o[at + 2u] = s.x.a2;
    output_keys.o[at + 10u] = s.y.a2;
    output_keys.o[at + 18u] = s.z.a2;
    output_keys.o[at + 3u] = s.x.a3;
    output_keys.o[at + 11u] = s.y.a3;
    output_keys.o[at + 19u] = s.z.a3;
    output_keys.o[at + 4u] = s.x.a4;
    output_keys.o[at + 12u] = s.y.a4;
    output_keys.o[at + 20u] = s.z.a4;
    output_keys.o[at + 5u] = s.x.a5;
    output_keys.o[at + 13u] = s.y.a5;
    output_keys.o[at + 21u] = s.z.a5;
    output_keys.o[at + 6u] = s.x.a6;
    output_keys.o[at + 14u] = s.y.a6;
    output_keys.o[at + 22u] = s.z.a6;
    output_keys.o[at + 7u] = s.x.a7;
    output_keys.o[at + 15u] = s.y.a7;
    output_keys.o[at + 23u] = s.z.a7;
    output_keys.o[at + 24u] = state.s[base + FLAG];
}

void check_stage(uint key) {
    uint in_at = key * 16u;
    Fe a = Fe(input_keys.r[in_at + 0u], input_keys.r[in_at + 1u], input_keys.r[in_at + 2u], input_keys.r[in_at + 3u], input_keys.r[in_at + 4u], input_keys.r[in_at + 5u], input_keys.r[in_at + 6u], input_keys.r[in_at + 7u]);
    Fe b = Fe(input_keys.r[in_at + 8u], input_keys.r[in_at + 9u], input_keys.r[in_at + 10u], input_keys.r[in_at + 11u], input_keys.r[in_at + 12u], input_keys.r[in_at + 13u], input_keys.r[in_at + 14u], input_keys.r[in_at + 15u]);
    Fe r;
    if (pc.d[0] == 0) r = fadd(a, b);
    else if (pc.d[0] == 1) r = fsub(a, b);
    else if (pc.d[0] == 2) r = fmul(a, b);
    else if (pc.d[0] == 3) r = fsq(a);
    else if (pc.d[0] == 4) r = fneg(a);
    else r = a;
    r = freeze(r);
    uint at = key * 25u;
    output_keys.o[at + 0u] = r.a0;
    output_keys.o[at + 1u] = r.a1;
    output_keys.o[at + 2u] = r.a2;
    output_keys.o[at + 3u] = r.a3;
    output_keys.o[at + 4u] = r.a4;
    output_keys.o[at + 5u] = r.a5;
    output_keys.o[at + 6u] = r.a6;
    output_keys.o[at + 7u] = r.a7;
}

void main() {
    uint key = gl_GlobalInvocationID.x;
    if (key >= pc.count) return;
    uint base = key * STRIDE;
    if (STAGE == 0) init_stage(key, base);
    else if (STAGE == 1) window_stage(base);
    else if (STAGE == 2) final_stage(key, base);
    else check_stage(key);
}
